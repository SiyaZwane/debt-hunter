{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debthunter.com/schemas/debt-hunter-v1.schema.json",
  "title": "Debt Hunter findings report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "findings", "metrics", "policy"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "run": { "$ref": "#/$defs/analysisRun" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/debtMetric" }
    },
    "policy": { "$ref": "#/$defs/policyResult" }
  },
  "$defs": {
    "analysisRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "toolVersion",
        "imageDigest",
        "timestamp",
        "repository",
        "project",
        "commit",
        "baseCommit",
        "branch",
        "pullRequest",
        "historyDepth",
        "engines",
        "degraded",
        "baselineProvenance"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "toolVersion": { "type": "string", "minLength": 1 },
        "imageDigest": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "repository": { "type": "string", "minLength": 1 },
        "project": { "type": ["string", "null"] },
        "commit": { "type": "string" },
        "baseCommit": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "pullRequest": { "type": ["string", "null"] },
        "historyDepth": { "enum": ["FULL", "PARTIAL", "SHALLOW"] },
        "engines": {
          "type": "array",
          "items": { "$ref": "#/$defs/engineStatus" }
        },
        "degraded": { "type": "boolean" },
        "baselineProvenance": { "type": ["string", "null"] }
      }
    },
    "engineStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "durationMs", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["OK", "DEGRADED", "FAILED"] },
        "durationMs": { "type": "integer", "minimum": 0 },
        "reason": { "type": ["string", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruleId",
        "category",
        "severity",
        "confidence",
        "path",
        "startLine",
        "message",
        "evidence",
        "score",
        "isNew",
        "fingerprint"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "category": {
          "enum": [
            "HOTSPOT",
            "TEMPORAL_COUPLING",
            "CHURN",
            "KNOWLEDGE_CONCENTRATION",
            "ARCHITECTURE",
            "STATIC_ANALYSIS",
            "DEPENDENCY",
            "TEST_HEALTH",
            "CUSTOM"
          ]
        },
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 0 },
        "message": { "type": "string", "minLength": 1 },
        "evidence": { "type": "object" },
        "score": { "type": "number" },
        "isNew": { "type": "boolean" },
        "fingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "debtMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "scope"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "policyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleVersion", "status", "reasons"],
      "properties": {
        "bundleVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASSED", "FAILED", "WOULD_FAIL"] },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/policyViolation" }
        }
      }
    },
    "policyViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "threshold", "actual", "findingIds"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "threshold": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 },
        "findingIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
